<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Sistema de Trabajos de Grado UTS</display-name>

    <!-- FILTRO DE AUTORIZACIÓN POR ROL -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>edu.uts.proyectos.controller.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- CONTROLADOR DE AUTENTICACIÓN -->
    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>edu.uts.proyectos.controller.AuthController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/auth</url-pattern>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- CONTROLADOR ADMINISTRADOR -->
    <servlet>
        <servlet-name>AdminController</servlet-name>
        <servlet-class>edu.uts.proyectos.controller.AdminController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminController</servlet-name>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <!-- CONTROLADOR COMITÉ / COORDINACIÓN -->
    <servlet>
        <servlet-name>ComiteController</servlet-name>
        <servlet-class>edu.uts.proyectos.controller.ComiteController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComiteController</servlet-name>
        <url-pattern>/comite-ctrl/*</url-pattern>
    </servlet-mapping>

    <!-- CONTROLADOR DIRECTOR -->
    <servlet>
        <servlet-name>DirectorController</servlet-name>
        <servlet-class>edu.uts.proyectos.controller.DirectorController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DirectorController</servlet-name>
        <url-pattern>/director-ctrl/*</url-pattern>
    </servlet-mapping>

    <!-- CONTROLADOR EVALUADOR -->
    <servlet>
        <servlet-name>EvaluadorController</servlet-name>
        <servlet-class>edu.uts.proyectos.controller.EvaluadorController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EvaluadorController</servlet-name>
        <url-pattern>/evaluador-ctrl/*</url-pattern>
    </servlet-mapping>

    <!-- CONTROLADOR ESTUDIANTE -->
    <servlet>
        <servlet-name>EstudianteController</servlet-name>
        <servlet-class>edu.uts.proyectos.controller.EstudianteController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EstudianteController</servlet-name>
        <url-pattern>/estudiante-ctrl/*</url-pattern>
    </servlet-mapping>

    <!-- ARCHIVO DE INICIO -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- TIMEOUT DE SESIÓN (30 MINUTOS) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
